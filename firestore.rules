rules_version = '2';

// Règles de sécurité Firestore du site KISUSI COMPANY.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Les documents des visiteurs ne contiennent qu'une date, posée par le serveur.
    function onlyTimestamp() {
      return request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // Administrateurs : créés à la main dans la console (document admins/{uid}).
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Champs communs aux deux types de publication (photos/vidéos dans « media »).
    function validCommon(d, textMin) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.text is string && d.text.size() >= textMin && d.text.size() <= 3000
        && d.media is list && d.media.size() <= 7
        && d.updatedAt == request.time;
    }
    // createdAt posé par le serveur à la création, puis inchangé ;
    // notifiedAt réservé au serveur (api/notify.js).
    function validDates() {
      return resource == null
        ? request.resource.data.createdAt == request.time && !('notifiedAt' in request.resource.data)
        : request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('notifiedAt', null) == resource.data.get('notifiedAt', null);
    }

    // Publications marketing (« Actualités ») : lisibles par tous, gérées par les administrateurs.
    match /posts/{postId} {
      function validPost() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'text', 'media', 'createdAt', 'updatedAt', 'notifiedAt'])
          && validCommon(d, 1);
      }

      allow read: if true;
      allow create, update: if isAdmin() && validPost() && validDates();
      allow delete: if isAdmin();

      // « J'aime » : un document par visiteur (connexion anonyme automatique).
      match /likes/{uid} {
        allow read: if true;
        allow create, update: if isOwner(uid) && onlyTimestamp();
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Produits en vente (« Catalogue ») : lisibles par tous, gérés par les administrateurs.
    match /products/{productId} {
      function validProduct() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'text', 'media', 'category', 'price', 'year', 'km', 'fuel',
                                 'credit', 'fromJapan', 'sold', 'createdAt', 'updatedAt', 'notifiedAt'])
          && validCommon(d, 0)
          && d.category in ['SUV', 'Berline', 'Pick-up', 'Moto']
          && d.price is number && d.price > 0
          && (d.year == null || d.year is number)
          && (d.km == null || (d.km is number && d.km >= 0))
          && d.fuel is string && d.fuel.size() <= 30
          && d.credit is bool && d.fromJapan is bool && d.sold is bool;
      }

      allow read: if true;
      allow create, update: if isAdmin() && validProduct() && validDates();
      allow delete: if isAdmin();
    }

    // Abonnés : le nombre est public, chacun gère son propre abonnement.
    match /follows/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && onlyTimestamp();
      allow delete: if isOwner(uid);
    }

    // Réservations en ligne : n'importe quel visiteur en crée une (connexion
    // anonyme), seuls les administrateurs les lisent et changent leur statut.
    match /orders/{orderId} {
      function validOrder() {
        let d = request.resource.data;
        return d.keys().hasOnly(['vehicle', 'price', 'deposit', 'name', 'phone', 'city', 'mode', 'payment', 'note', 'uid', 'status', 'createdAt'])
          && d.vehicle is string && d.vehicle.size() > 0 && d.vehicle.size() <= 150
          && d.price is number && d.price > 0
          && d.deposit is number && d.deposit >= 0 && d.deposit <= d.price
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
          && d.phone is string && d.phone.size() >= 6 && d.phone.size() <= 30
          && d.city is string && d.city.size() <= 60
          && d.mode in ['comptant', 'credit']
          && d.payment in ['mobile-money', 'agence']
          && d.note is string && d.note.size() <= 1000;
      }

      allow create: if signedIn() && validOrder()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'nouvelle'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['nouvelle', 'confirmee', 'acompte', 'livree', 'annulee'];
    }

    // Jetons de notification : jamais lisibles depuis le site (seul le serveur les lit).
    match /pushTokens/{uid} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['token', 'at'])
        && request.resource.data.token is string && request.resource.data.token.size() < 4096
        && request.resource.data.at == request.time;
      allow delete: if isOwner(uid);
      allow read: if false;
    }
  }
}
